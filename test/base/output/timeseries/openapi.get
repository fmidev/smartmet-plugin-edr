Status: 200
Content-Type: application/vnd.oai.openapi+json;version=3.1

{"components":{"parameters":{"bbox":{"description":"Only data that has a geometry intersecting the bounding box is selected: lower left corner and upper right corner, with optional minimum and maximum heights (minx,miny,maxx,maxy or minx,miny,minz,maxx,maxy,maxz).","explode":false,"in":"query","name":"bbox","schema":{"items":{"type":"number"},"maxItems":6,"minItems":4,"type":"array"},"style":"form"},"bbox-crs":{"description":"The coordinate reference system of bbox.","in":"query","name":"bbox-crs","schema":{"format":"uri","type":"string"}},"crs":{"description":"The coordinate reference system of the response.","in":"query","name":"crs","schema":{"type":"string"}},"datetime":{"description":"A date-time or an interval (RFC 3339). Open intervals use '..' as the open end, e.g. '2026-10-09T00:00:00Z/..'.","in":"query","name":"datetime","schema":{"type":"string"}},"limit":{"description":"The maximum number of items to return.","in":"query","name":"limit","schema":{"minimum":1,"type":"integer"}}},"responses":{"BadRequest":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/exception"}},"application/problem+json":{"schema":{"$ref":"#/components/schemas/exception"}}},"description":"The request is not valid."},"ConformanceDeclaration":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/confClasses"}}},"description":"The conformance classes the API conforms to."},"LandingPage":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/landingPage"}}},"description":"The landing page links to the API definition, the conformance declaration and the data."},"NotAcceptable":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/exception"}},"application/problem+json":{"schema":{"$ref":"#/components/schemas/exception"}}},"description":"None of the requested media types is supported."},"NotFound":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/exception"}},"application/problem+json":{"schema":{"$ref":"#/components/schemas/exception"}}},"description":"The resource does not exist."},"ServerError":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/exception"}},"application/problem+json":{"schema":{"$ref":"#/components/schemas/exception"}}},"description":"A server error occurred."}},"schemas":{"confClasses":{"properties":{"conformsTo":{"items":{"type":"string"},"type":"array"}},"required":["conformsTo"],"type":"object"},"exception":{"properties":{"code":{"type":"string"},"description":{"type":"string"},"detail":{"type":"string"},"instance":{"type":"string"},"status":{"type":"integer"},"title":{"type":"string"},"type":{"type":"string"}},"type":"object"},"landingPage":{"properties":{"attribution":{"type":"string"},"description":{"type":"string"},"links":{"items":{"$ref":"#/components/schemas/link"},"type":"array"},"title":{"type":"string"}},"required":["links"],"type":"object"},"link":{"properties":{"href":{"type":"string"},"hreflang":{"type":"string"},"length":{"type":"integer"},"rel":{"type":"string"},"templated":{"type":"boolean"},"title":{"type":"string"},"type":{"type":"string"}},"required":["href","rel"],"type":"object"}}},"externalDocs":{"description":"Using the TimeSeries API","url":"https://github.com/fmidev/smartmet-plugin-edr/blob/master/docs/Using-the-Timeseries-API.md"},"info":{"description":"Time series of forecasts and observations at locations, areas and paths. The values to return are selected with the param option, see the documentation for the parameter names and functions.","title":"SmartMet TimeSeries API","version":"1.0"},"openapi":"3.1.1","paths":{"/timeseries":{"get":{"description":"Returns the values listed in param for the requested locations and times. At least one location option and param are required.","operationId":"getTimeSeries_timeseries","parameters":[{"description":"Producer(s) of the data. A comma separates producers by area, a semicolon by time.","in":"query","name":"producer","schema":{"type":"string","x-known-values":["airquality","airquality_daily_fmi","airquality_daily_urban","airquality_fmi","airquality_urban","buoy","climate_tmax","climatepoints","copernicus","daily","ecmwf_eurooppa_pinta","ecmwf_maailma_piste","ecmwf_skandinavia_painepinta","external_radiation","flash","fmi","fmiforecast","foreign","harmonie_hybrid","hirlam","hirwind","hourly","icebuoy","kalman","lammitystarve","mareograph","mast","minute_rad","monthly","observations_fmi","observations_fmi_extaws","opendata","opendata_buoy","opendata_daily","opendata_mareograph","opendata_minute","pal_skandinavia","pal_skandinavia2","research","road","solar","syke","synop","tosummertime","towintertime","tutka_suomi_rr","weeklyclimatology"]},"x-group":"Data"},{"description":"Alias of producer","in":"query","name":"model","schema":{"type":"string","x-known-values":["airquality","airquality_daily_fmi","airquality_daily_urban","airquality_fmi","airquality_urban","buoy","climate_tmax","climatepoints","copernicus","daily","ecmwf_eurooppa_pinta","ecmwf_maailma_piste","ecmwf_skandinavia_painepinta","external_radiation","flash","fmi","fmiforecast","foreign","harmonie_hybrid","hirlam","hirwind","hourly","icebuoy","kalman","lammitystarve","mareograph","mast","minute_rad","monthly","observations_fmi","observations_fmi_extaws","opendata","opendata_buoy","opendata_daily","opendata_mareograph","opendata_minute","pal_skandinavia","pal_skandinavia2","research","road","solar","syke","synop","tosummertime","towintertime","tutka_suomi_rr","weeklyclimatology"]},"x-group":"Data"},{"description":"Data source: querydata or grid","in":"query","name":"source","schema":{"type":"string"},"x-group":"Data"},{"description":"Comma separated list of the values to return: data parameter names of the producer, meta parameters such as name, time, lat, lon, fmisid, and functions such as mean_t(Temperature/24h/0h). See the documentation for the full syntax.","explode":false,"in":"query","name":"param","required":true,"schema":{"examples":["name,time,temperature"],"items":{"type":"string"},"type":"array"},"style":"form","x-meta-parameters":["name","time","origintime","lat","lon","latlon","lonlat","geoid","fmisid","wmo","elevation","localtz","utctime","localtime","timestring","level","model","producer","stationname","distance"]},{"description":"Start time: ISO 8601, YYYYMMDDHHMI, a relative time like +2h or -1d, or 'data' for the first time of the data. The default is the next full hour.","in":"query","name":"starttime","schema":{"type":"string"},"x-group":"Time"},{"description":"End time in the formats of starttime, or 'data'. The default is starttime plus 24 hours.","in":"query","name":"endtime","schema":{"type":"string"},"x-group":"Time"},{"description":"Time step in minutes, or 'data' to select the times of the data. The default is 60.","in":"query","name":"timestep","schema":{"type":"string"},"x-group":"Time"},{"description":"Number of times to return, an alternative to endtime","in":"query","name":"timesteps","schema":{"minimum":0,"type":"integer"},"x-group":"Time"},{"description":"Number of time steps to skip from the start","in":"query","name":"startstep","schema":{"minimum":0,"type":"integer"},"x-group":"Time"},{"description":"Comma separated list of hours to select, e.g. 12,18","explode":false,"in":"query","name":"hour","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Time"},{"description":"Comma separated list of times HHMI to select, e.g. 1200,1230","explode":false,"in":"query","name":"time","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Time"},{"description":"Comma separated list of days of the month to select","explode":false,"in":"query","name":"day","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Time"},{"description":"Comma separated list of weekdays to select","explode":false,"in":"query","name":"weekday","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Time"},{"description":"Override the current time","in":"query","name":"now","schema":{"type":"string"},"x-group":"Time"},{"description":"Time zone of the request and the response times, the default is 'localtime'","in":"query","name":"tz","schema":{"type":"string"},"x-group":"Time"},{"description":"Origin time of the model run to use, the latest by default","in":"query","name":"origintime","schema":{"type":"string"},"x-group":"Time"},{"description":"Use the current time instead of the next full hour as the default start time","in":"query","name":"usecurrenttime","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Time"},{"description":"Time interval for observation queries","in":"query","name":"interval","schema":{"type":"string"},"x-group":"Time"},{"description":"Location name, optionally with a radius in km: place=Helsinki or place=Helsinki:20","in":"query","name":"place","schema":{"type":"string"},"x-group":"Location"},{"description":"Comma separated list of location names","explode":false,"in":"query","name":"places","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Longitude and latitude, optionally with a radius: lonlat=24.94,60.17 or lonlat=24.94,60.17:15","explode":false,"in":"query","name":"lonlat","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of longitude,latitude pairs","explode":false,"in":"query","name":"lonlats","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Latitude and longitude: latlon=60.17,24.94","explode":false,"in":"query","name":"latlon","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of latitude,longitude pairs","explode":false,"in":"query","name":"latlons","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Location identifier of the location database","in":"query","name":"geoid","schema":{"type":"string"},"x-group":"Location"},{"description":"Comma separated list of location identifiers","explode":false,"in":"query","name":"geoids","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Locations of a keyword of the location database, e.g. synop_fi","in":"query","name":"keyword","schema":{"type":"string"},"x-group":"Location","x-smartmet-locations":{"language":"lang","parameter":"keyword","path":"/timeseries","query":{"format":"json","param":"name,geoid,fmisid,wmo,lat,lon,elevation,region,country,tz","timesteps":"1"}}},{"description":"Restrict location name searches to a keyword","in":"query","name":"inkeyword","schema":{"type":"string"},"x-group":"Location","x-smartmet-locations":{"language":"lang","parameter":"keyword","path":"/timeseries","query":{"format":"json","param":"name,geoid,fmisid,wmo,lat,lon,elevation,region,country,tz","timesteps":"1"}}},{"description":"Feature codes for limiting coordinate searches, e.g. SYNOP or PPL,PPLX","explode":false,"in":"query","name":"feature","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Area name, optionally with a radius: area=Turku or area=Turku:10","in":"query","name":"area","schema":{"type":"string"},"x-group":"Location"},{"description":"Comma separated list of area names","explode":false,"in":"query","name":"areas","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Path as a list of coordinates, optionally with a radius","in":"query","name":"path","schema":{"type":"string"},"x-group":"Location"},{"description":"List of paths","explode":false,"in":"query","name":"paths","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Bounding box minlon,minlat,maxlon,maxlat, optionally with a radius","in":"query","name":"bbox","schema":{"type":"string"},"x-group":"Location"},{"description":"List of bounding boxes","explode":false,"in":"query","name":"bboxes","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Geometry as Well Known Text, optionally with a radius","in":"query","name":"wkt","schema":{"type":"string"},"x-group":"Location"},{"description":"X coordinate in the crs","in":"query","name":"x","schema":{"type":"number"},"x-group":"Location"},{"description":"Y coordinate in the crs","in":"query","name":"y","schema":{"type":"number"},"x-group":"Location"},{"description":"Coordinate reference system of x and y, e.g. EPSG:3067","in":"query","name":"crs","schema":{"type":"string"},"x-group":"Location"},{"description":"Comma separated list of FMI station identifiers","explode":false,"in":"query","name":"fmisid","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of WMO station identifiers","explode":false,"in":"query","name":"wmo","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of LPNN station identifiers","explode":false,"in":"query","name":"lpnn","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of road weather station identifiers","explode":false,"in":"query","name":"rwsid","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of station identifiers","explode":false,"in":"query","name":"sid","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Comma separated list of WIGOS station identifiers","explode":false,"in":"query","name":"wsi","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Maximum distance to the data or the station, a number with an optional unit (km, m, mi, nmi, ...), e.g. 10km","in":"query","name":"maxdistance","schema":{"type":"string"},"x-group":"Location"},{"description":"Number of nearest stations to return per location","in":"query","name":"numberofstations","schema":{"minimum":0,"type":"integer"},"x-group":"Location"},{"description":"Observation station type","in":"query","name":"stationtype","schema":{"type":"string"},"x-group":"Location"},{"description":"Comma separated list of observation station groups","explode":false,"in":"query","name":"stationgroups","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Location"},{"description":"Group the results of an area (default 1)","in":"query","name":"groupareas","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Location"},{"description":"Group the given locations as one area","in":"query","name":"grouplocations","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Location"},{"description":"Source of the area geometries","in":"query","name":"areasource","schema":{"type":"string"},"x-group":"Location"},{"description":"Distance in kilometers between the points sampled along a path","in":"query","name":"step","schema":{"type":"number"},"x-group":"Location"},{"description":"Model level","in":"query","name":"level","schema":{"type":"string"},"x-group":"Data"},{"description":"Comma separated list of model levels","explode":false,"in":"query","name":"levels","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Data"},{"description":"Range of model levels min,max","in":"query","name":"levelrange","schema":{"type":"string"},"x-group":"Data"},{"description":"Type of the levels, e.g. pressure or model","in":"query","name":"leveltype","schema":{"type":"string"},"x-group":"Data"},{"description":"Pressure level in hPa","in":"query","name":"pressure","schema":{"type":"number"},"x-group":"Data"},{"description":"Comma separated list of pressure levels in hPa","explode":false,"in":"query","name":"pressures","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Data"},{"description":"Height in meters","in":"query","name":"height","schema":{"type":"number"},"x-group":"Data"},{"description":"Comma separated list of heights in meters","explode":false,"in":"query","name":"heights","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Data"},{"description":"Use the nearest grid point with valid data","in":"query","name":"findnearestvalid","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Data"},{"description":"Use the observation data cache","in":"query","name":"useDataCache","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Data"},{"description":"SQL style filter of the observation station identifiers","in":"query","name":"station_id","schema":{"type":"string"},"x-group":"Data"},{"description":"SQL style filter of the observation quality codes, e.g. le 5","in":"query","name":"data_quality","schema":{"type":"string"},"x-group":"Data"},{"description":"SQL style filter of the sounding types","in":"query","name":"sounding_type","schema":{"type":"string"},"x-group":"Data"},{"description":"SQL style filter of the sounding level significances","in":"query","name":"significance","schema":{"type":"string"},"x-group":"Data"},{"description":"Language of the location names","in":"query","name":"lang","schema":{"type":"string"},"x-group":"Data"},{"description":"Locale of the formatted values, e.g. fi_FI","in":"query","name":"locale","schema":{"type":"string"},"x-group":"Data"},{"description":"Output format","in":"query","name":"format","schema":{"default":"ascii","enum":["ascii","csv","debug","html","json","php","serial","wxml","xml"],"type":"string"},"x-group":"Output"},{"description":"Precision of the values: normal, double, full, auto or another configured name","in":"query","name":"precision","schema":{"type":"string"},"x-group":"Output"},{"description":"Text of missing values, the default is nan","in":"query","name":"missingtext","schema":{"type":"string"},"x-group":"Output"},{"description":"Format of the times: iso, timestamp, sql, xml, epoch, iso2, iso8601 or http","in":"query","name":"timeformat","schema":{"type":"string"},"x-group":"Output"},{"description":"strftime pattern of the timestring parameter","in":"query","name":"timestring","schema":{"type":"string"},"x-group":"Output"},{"description":"Field separator of the ascii format","in":"query","name":"separator","schema":{"type":"string"},"x-group":"Output"},{"description":"Fields output as attributes in xml, json, php and serial formats","explode":false,"in":"query","name":"attributes","schema":{"items":{"type":"string"},"type":"array"},"style":"form","x-group":"Output"},{"description":"Style of the xml format: attributes, tags or mixed","in":"query","name":"xmlstyle","schema":{"type":"string"},"x-group":"Output"},{"description":"Version of the wxml format","in":"query","name":"version","schema":{"type":"string"},"x-group":"Output"},{"description":"First row to output","in":"query","name":"startrow","schema":{"minimum":0,"type":"integer"},"x-group":"Output"},{"description":"Maximum number of rows to output","in":"query","name":"maxresults","schema":{"minimum":0,"type":"integer"},"x-group":"Output"},{"description":"Floating point format: none, fixed or scientific","in":"query","name":"floatfield","schema":{"type":"string"},"x-group":"Output"},{"description":"Width of the numeric fields","in":"query","name":"width","schema":{"minimum":0,"type":"integer"},"x-group":"Output"},{"description":"Fill character of the numeric fields","in":"query","name":"fill","schema":{"type":"string"},"x-group":"Output"},{"description":"Alignment of the numeric fields: left, right or internal","in":"query","name":"adjustfield","schema":{"type":"string"},"x-group":"Output"},{"description":"Show the + sign of positive numbers","in":"query","name":"showpos","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Output"},{"description":"Use uppercase in scientific notation","in":"query","name":"uppercase","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Output"},{"description":"Return error details as HTML","in":"query","name":"debug","schema":{"enum":["0","1","true","false"],"type":"string"},"x-group":"Output"}],"responses":{"200":{"content":{"application/json":{"schema":{"oneOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"items":{"items":{"additionalProperties":true,"type":"object"},"type":"array"},"type":"array"},{"additionalProperties":true,"type":"object"}]}},"application/xml":{"schema":{"type":"string"}},"text/csv":{"schema":{"type":"string"}},"text/html":{"schema":{"type":"string"}},"text/plain":{"schema":{"type":"string"}}},"description":"The time series in the requested format"},"400":{"$ref":"#/components/responses/BadRequest"},"500":{"$ref":"#/components/responses/ServerError"}},"summary":"Time series data","tags":["TimeSeries"]}},"/timeseries/api":{"get":{"description":"This document. With f=html, or when the client prefers text/html, the documentation page is returned instead.","operationId":"getAPI","parameters":[{"description":"The format of the response: json (the default) or html.","in":"query","name":"f","schema":{"enum":["json","html"],"type":"string"}}],"responses":{"200":{"content":{"application/vnd.oai.openapi+json;version=3.1":{"schema":{"type":"object"}},"text/html":{"schema":{"type":"string"}}},"description":"The OpenAPI 3.1 definition of the API."},"400":{"$ref":"#/components/responses/BadRequest"},"500":{"$ref":"#/components/responses/ServerError"}},"summary":"API definition","tags":["Capabilities"]}},"/timeseries/api/docs":{"get":{"description":"Human-readable documentation of the API, generated from its definition.","operationId":"getAPIDocs","responses":{"200":{"content":{"text/html":{"schema":{"type":"string"}}},"description":"The documentation page."},"404":{"$ref":"#/components/responses/NotFound"}},"summary":"API documentation","tags":["Capabilities"]}},"/timeseries/api/docs/{file}":{"get":{"operationId":"getAPIDocsFile","parameters":[{"description":"File name","in":"path","name":"file","required":true,"schema":{"enum":["swagger-ui-bundle.js","swagger-ui-standalone-preset.js","swagger-ui.css","favicon-16x16.png","favicon-32x32.png","smartmet-swagger-ui.js"],"type":"string"}}],"responses":{"200":{"description":"The file"},"404":{"$ref":"#/components/responses/NotFound"}},"summary":"Files of the documentation page","tags":["Capabilities"]}},"/timeseries/api/producers":{"get":{"description":"The producers the API reads, with their parameters, areas, times and levels, and a dictionary of the parameter descriptions and units. Parameter names are lower case.","operationId":"getProducers_timeseries","parameters":[{"description":"Only the producers of this source","in":"query","name":"source","schema":{"enum":["querydata","grid","observation"],"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"parameters":{"type":"object"},"producers":{"type":"array"}},"required":["producers","parameters"],"type":"object"}}},"description":"The producers"},"400":{"$ref":"#/components/responses/BadRequest"},"500":{"$ref":"#/components/responses/ServerError"}},"summary":"Producers and their parameters","tags":["Capabilities"]}}},"servers":[{"url":"/"}],"tags":[{"description":"Time series queries","name":"TimeSeries"},{"description":"The API definition","name":"Capabilities"}]}