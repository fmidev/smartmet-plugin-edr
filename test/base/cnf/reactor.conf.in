# The catalog is tested without the data explorer: whether its files are installed must not
# change the outputs
api_catalog:
{
	explorer = false;
};

plugins:
{
	edr:
	{
	        configfile      = "edr.conf";
	        libfile         = "../../../edr.so";
	};
};

engines:
{
	avi:
	{
	        configfile      = "../../cnf/avi.conf";
	};
	grid:
	{
		configfile	= "nogrid.conf";
	};
	geonames:
	{
	        configfile      = "../../cnf/geonames.conf";
	};
	querydata:
	{
	        configfile      = "../../cnf/querydata.conf";
	};
	gis:
	{
	        configfile      = "../../cnf/gis.conf";
	};
	# Must be after geonames
	observation:
	{
	        configfile      = "observation_@DB_TYPE@.conf";
	};
};
